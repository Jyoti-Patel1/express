<%- include('../partials/head')%>
  </head>
  <body>
   <%- include('../partials/nav')%>
    <main class="home-detail-page">
      <div class="detail-heading">
        <p class="detail-eyebrow">Welcome to</p>
        <h1>Details of <%= home.houseName %></h1>
      </div>

      <article class="home-detail-card">
        <div class="detail-image-wrap">
          <% if (home.photoUrl) { %>
            <img src="/image/<%= home.photoUrl %>" alt="<%= home.houseName %>" class="detail-image" />
          <% } else { %>
            <div class="detail-image detail-placeholder">No image available</div>
          <% } %>
        </div>

        <div class="detail-content">
          <div class="detail-row">
            <h2>Description</h2>
            <p>A welcoming home for your next stay.</p>
          </div>
          <div class="detail-row">
            <h2>Location</h2>
            <p><%= home.location %></p>
          </div>
          <div class="detail-row detail-row-inline">
            <div>
              <h2>Price</h2>
              <p class="detail-price">Rs<%= home.price %> <span>/ night</span></p>
            </div>
            <div>
              <h2>Rating</h2>
              <p class="detail-rating">★ <%= home.rating %> / 5</p>
            </div>
          </div>
          <div>
          <%- include('../partials/favourite')%>
          </div>
          
          
        </div>
      </article>
    </main>
  </body>
</html>
