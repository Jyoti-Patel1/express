<%- include('../partials/head')%>
  </head>
  <body>
    <%- include('../partials/nav')%>
    <main class="form-page">
      <h2>Edit your home</h2>
      <form class="home-form" action="/host/edit-home" method="post">
        <input type="hidden" name="id" value="<%= home.id %>" />
        <input class="input" type="text" name="houseName" value="<%= home.houseName %>" placeholder="enter house name" />
        <input class="input" type="text" name="price" value="<%= home.price %>" placeholder="price per night" />
        <input class="input" type="text" name="location" value="<%= home.location %>" placeholder="enter your location" />
        <input class="input" type="text" name="rating" value="<%= home.rating %>" placeholder="rating" />
        <input class="input" type="text" name="photoUrl" value="<%= home.photoUrl %>" placeholder="photo Url" />
        <textarea class="input" name="description" placeholder="describe your home" rows="4"><%= home.description %></textarea>
        <input class="input" id="input-submit" type="submit" value="Save changes" />
      </form>
    </main>
  </body>
</html>
