<%- include('partials/head')%>
  </head>
  <body>
   <%- include('partials/nav')%> 
    <main class="form-page">
      <h2>register your home here</h2>
      <form class="home-form" action="/host/add-home" method="post">
        <input
          class="input"
          type="text"
          name="houseName"
          placeholder="enter house name"
        />
        <input
          class="input"
          type="text"
          name="price"
          placeholder="price per night"
        />
        <input
          class="input"
          type="text"
          name="location"
          placeholder="enter your location"
        />
        <input
          class="input"
          type="text"
          name="rating"
          placeholder="rating"
        />
        <input
          class="input"
          type="text"
          name="photoUrl"
          placeholder="photo Url"
        />
        <input class="input" id="input-submit" type="submit" />
      </form>
    </main>
  </body>
</html>
